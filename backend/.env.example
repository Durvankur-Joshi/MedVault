# ==================================================
# MedVault Backend Configuration
# ==================================================
# Copy this file to .env and update the values.
# Never commit .env to version control.

# ==================================================
# LOCAL DATABASE (Docker Compose)
# ==================================================
# Use this for local development with Docker PostgreSQL:
#   docker-compose up -d
DATABASE_URL=postgresql://medvault_user:medvault_dev_password@localhost:5432/medvault

# ==================================================
# SUPABASE DATABASE (Deployment)
# ==================================================
# To use Supabase-hosted PostgreSQL instead, set DATABASE_URL to your
# Supabase connection string and configure the keys below.
#
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Supabase project URL (used for frontend/API, not for direct DB access)
SUPABASE_URL=https://your-project.supabase.co
# Supabase anonymous key (safe for frontend use)
SUPABASE_ANON_KEY=your-anon-key
# Supabase service-role key (BACKEND ONLY — never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==================================================
# CORS
# ==================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==================================================
# JWT AUTHENTICATION
# ==================================================
# Change this in production! Use a cryptographically random string.
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ==================================================
# PHASE 3 — MEDICAL RECORD ENCRYPTION (AES-256-GCM)
# ==================================================
# Exactly 32 bytes (256 bits), base64-encoded.
# In production, load from KMS (AWS KMS, GCP KMS, Azure Key Vault, HashiCorp Vault).
# Example format: MEDICAL_RECORD_ENCRYPTION_KEY=<32-byte-base64-encoded-key>
MEDICAL_RECORD_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# ==================================================
# PHASE 3 — OFF-CHAIN ENCRYPTED STORAGE
# ==================================================
STORAGE_TYPE=local
STORAGE_PATH=storage/encrypted

# ==================================================
# PHASE 4 — BLOCKCHAIN & EVM CONTRACTS
# ==================================================
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_NETWORK_NAME=Hardhat Localhost
# Development private key for backend automated contract calls (Hardhat Account #0)
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
IDENTITY_REGISTRY_ADDRESS=
MEDICAL_RECORD_REGISTRY_ADDRESS=
CONSENT_MANAGER_ADDRESS=
PATIENT_COMMITMENT_SALT=medvault_patient_secret_salt_2026
